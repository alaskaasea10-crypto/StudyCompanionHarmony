# 在华为云 ModelArts MaaS 控制台创建的 API Key。
# 复制本文件为 .env 后填写；不要把 .env 发给他人或提交到 Git。
OPENPANGU_API_KEY=

# 华为云 openPangu MaaS 接口。若控制台给出的地址或模型名不同，以控制台为准。
OPENPANGU_API_URL=https://api.modelarts-maas.com/v2/chat/completions
OPENPANGU_MODEL=openpangu-2.0-flash

# 本地开发服务配置。模拟器通过 10.0.2.2、同一 Wi-Fi 下的真机通过电脑局域网 IP 访问。
# 只在可信任的本地网络中运行；不要把此服务直接暴露到公网。
AGENT_BACKEND_HOST=0.0.0.0
AGENT_BACKEND_PORT=8000
